# =============================================================================
# OUTPILOT v2 — Environment variables (template)
# -----------------------------------------------------------------------------
# Copy this file to .env.local and fill each value. .env.local is git-ignored.
# Never commit real keys. Never paste secrets in chat.
#
# Google OAuth (Client ID / Secret) is NOT declared here: it lives in the
# Supabase panel (Authentication -> Providers -> Google). The app only talks
# to Supabase Auth.
#
# Twenty CRM vars belong to Phase 3 (T031+) and are intentionally omitted.
# =============================================================================


# --- Supabase ----------------------------------------------------------------
# Project: outpilot-v2 (EU region). Values live in the Supabase dashboard under
# Project Settings -> API (URL + anon + service_role) and Project Settings ->
# Database -> Connection string (for SUPABASE_DB_URL).

# Public project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key. Used by the browser client. RLS is what protects data,
# not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Bypasses RLS. NEVER expose to the browser. Only imported
# from files under /jobs/**, and every query there must filter tenant_id
# explicitly (enforced by lint rule in T009).
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, used by psql when applying migrations
# from supabase/migrations/. Use the SESSION POOLER endpoint on port 5432 —
# not the transaction pooler (6543) and not the direct connection. Format:
#   postgresql://postgres.<ref>:<password>@aws-*-eu-*.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=


# --- Anthropic ---------------------------------------------------------------
# Used by lib/ai/claude.ts (T007). Model routing (haiku for volume,
# sonnet for quality) is defined in config/models.ts, not here.
ANTHROPIC_API_KEY=


# --- Supabase dev tooling (optional) -----------------------------------------
# Personal access token used ONLY by `npm run gen-types` to hit the Supabase
# Management API. Not read by the app at runtime, not validated by
# `npm run env:check`. Generate one at:
#   https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=


# --- Inngest -----------------------------------------------------------------
# Event key: identifies this app when sending events to Inngest.
# Signing key: verifies incoming webhooks from Inngest to /api/inngest.
# Both live in the Inngest dashboard for the outpilot-v2 environment.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
