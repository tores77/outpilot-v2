# =============================================================================
# OUTPILOT v2 — Environment variables (template)
# -----------------------------------------------------------------------------
# Copy this file to .env.local and fill each value. .env.local is git-ignored.
# Never commit real keys. Never paste secrets in chat.
#
# Google OAuth (Client ID / Secret) is NOT declared here: it lives in the
# Supabase panel (Authentication -> Providers -> Google). The app only talks
# to Supabase Auth.
#
# Twenty CRM vars belong to Phase 3 (T031+) and are intentionally omitted.
# =============================================================================


# --- Supabase ----------------------------------------------------------------
# Project: outpilot-v2 (EU region). Values live in the Supabase dashboard under
# Project Settings -> API (URL + anon + service_role) and Project Settings ->
# Database -> Connection string (for SUPABASE_DB_URL).

# Public project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key. Used by the browser client. RLS is what protects data,
# not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Bypasses RLS. NEVER expose to the browser. Only imported
# from files under /jobs/**, and every query there must filter tenant_id
# explicitly (enforced by lint rule in T009).
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, used by psql when applying migrations
# from supabase/migrations/. Use the SESSION POOLER endpoint on port 5432 —
# not the transaction pooler (6543) and not the direct connection. Format:
#   postgresql://postgres.<ref>:<password>@aws-*-eu-*.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=


# --- Anthropic ---------------------------------------------------------------
# Used by lib/ai/claude.ts (T007). Model routing (haiku for volume,
# sonnet for quality) is defined in config/models.ts, not here.
ANTHROPIC_API_KEY=


# --- Vibe Prospecting / Explorium --------------------------------------------
# Required at runtime once T014 (Nova bulk fetch) ships. Optional in local dev
# until the fetch actually runs; env:check emits a warning if unset.
# Header format: `api_key: <value>` (not Bearer). Obtain at
#   https://admin.explorium.ai/api-key
VIBE_API_KEY=


# --- Supabase dev tooling (optional) -----------------------------------------
# Personal access token used ONLY by `npm run gen-types` to hit the Supabase
# Management API. Not read by the app at runtime, not validated by
# `npm run env:check`. Generate one at:
#   https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=


# --- Inngest -----------------------------------------------------------------
# Event key: identifies this app when sending events to Inngest.
# Signing key: verifies incoming webhooks from Inngest to /api/inngest.
# Both live in the Inngest dashboard for the outpilot-v2 environment.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=


# --- Lemlist ----------------------------------------------------------------
# API key para autenticacion HTTP Basic contra https://api.lemlist.com/api.
# Formato del header: `Authorization: Basic base64(":" + LEMLIST_API_KEY)`
# (usuario vacio, key como password). Obtener en:
#   https://app.lemlist.com/settings/integrations (seccion API)
# Rate limit del provider: 20 req / 2 s por key. El cliente respetara
# Retry-After y X-RateLimit-*.
# Usado por los probes de T018 en local; se anadira a Vercel cuando exista
# codigo de runtime que la lea (T019/T023) — superficie minima hasta
# entonces.
LEMLIST_API_KEY=

# Secret del webhook de Lemlist. DOS CAPAS, UNA sola variable:
#   (1) En la URL: /api/webhooks/lemlist/<LEMLIST_WEBHOOK_SECRET>.
#   (2) En el body: Lemlist devuelve el valor en payload.secret
#       (hallazgo doc oficial 2026-10-01; no es cabecera ni HMAC).
# Mismo valor en ambas comprobaciones porque el campo Secret de
# Lemlist es inmutable; separar en dos vars obliga a borrar y
# recrear el webhook (previsto para la próxima rotación).
# Generar con `openssl rand -hex 32` y pegar aquí + en Vercel
# (redeploy obligatorio). Nunca pegar en chat ni en issues. T025.
LEMLIST_WEBHOOK_SECRET=

# Modo de la segunda capa (comprobación del secret en payload.secret).
# Valores:
#   observe (default) — mismatch NO bloquea; el evento se persiste
#     con processing_error = body_secret_missing | body_secret_mismatch
#     y responde 200. Útil mientras calibramos: nos permite ver
#     cuántos eventos reales llegan con el secret correcto antes de
#     endurecer. Cualquier valor que no sea exactamente "enforce" cae
#     a observe por seguridad operativa (un typo nunca activa enforce).
#   enforce — mismatch → 404 silencioso. Pasar a este modo cuando N
#     eventos reales hayan llegado sin mismatch.
LEMLIST_WEBHOOK_BODY_CHECK=observe

# Modo del guardarraíl de entregabilidad (T025 bloque C). Mismo
# patrón observe/enforce que el body-check:
#   observe (default) — detecta bounce rate > 2 % o complaint rate
#     > 0,1 % en 24h con sent >= 20, inserta alerta en `alerts`,
#     NO llama a Lemlist ni cambia campaigns.status. Permite medir
#     cuántas pausas se dispararían antes de endurecer.
#   enforce — además de la alerta: POST /api/campaigns/:id/pause en
#     Lemlist y pone campaigns.status = 'paused_guardrail'. El
#     sistema NUNCA reanuda solo; Pere revisa en /campaigns y
#     decide manualmente si vuelve a 'active'.
# Cualquier valor que no sea exactamente "enforce" cae a observe.
GUARDRAILS_ENFORCE=observe
